from utils import words, char_to_i, i_to_char
import torch
import torch.nn.functional as F
import random

g = torch.Generator().manual_seed(2147483647)

# Build the dataset

block_size = 3 # context length: how many characters do we take to predict the next?
vocab_size = len(i_to_char) # number of characters 

def build_dataset(words):
    X, Y = [], []

    for w in words:

        context = [0] * block_size # initialize with all '...'
        for char in w + '.':
            ix = char_to_i[char]
            X.append(context)
            Y.append(ix)
            context = context[1:] + [ix]

    # An element of X contains three (indices for) characters, like [e, m, m]
    X = torch.tensor(X)
    # An element of Y contains the (index for) the next char, like [a] (as in emma)
    Y = torch.tensor(Y)
    return X, Y

random.seed(42)
random.shuffle(words)
n1 = int(0.8*len(words))
n2 = int(0.9*len(words))

# Train (80%) split, dev/valuation split (10%), test split (10%)
Xtr, Ytr   = build_dataset(words[:n1])
Xdev, Ydev = build_dataset(words[n1:n2])
Xte, Yte   = build_dataset(words[n2:])

# Parameters 
n_embed = 10 # embedding dimension
n_hidden = 200 # number of neurons in hidden layer
C  = torch.randn((vocab_size, n_embed), generator=g) 
W1 = torch.randn((n_embed * block_size, n_hidden), generator=g) 
b1 = torch.randn(n_hidden, generator=g)
W2 = torch.randn((n_hidden, vocab_size), generator=g)
b2 = torch.rand(vocab_size, generator=g)

parameters = [C, W1, b1, W2, b2]
for p in parameters:
    p.requires_grad = True

# ============ Makemore part 2

# Explanation of emb = C[X]

    # Let C = torch.randn((27, 2))
    # C is the embedding matrix, sending each of the vocab_size=27 chars to a (say) n_embed=2 dimensional embedding vector
    #
    # X: 32 examples
    # │
    # ├── [0, 0, 5]
    # ├── [0, 5, 13]
    # ├── [5, 13, 13]
    # │
    # └── ...
    # 
    # ↓ Embedding
    # 
    # emb: 32 examples
    # │
    # ├── [[0.2, -1.1], [0.2, -1.1], [0.4, 0.8]]
    # ├── [[0.2, -1.1], [0.4, 0.8], [-0.9, 0.4]]
    # ├── [[0.4, 0.8], [-0.9, 0.4], [-0.9, 0.4]]
    # │
    # └── ...

# Build a NN that takes the X's and predicts the Y's

max_steps = 20_000
batch_size = 32
loss_i = []
for i in range(max_steps):

    # Mini batch: list of batch_size many random indices between [0, num of rows in X (aka num of examples)]
    ix = torch.randint(0, Xtr.shape[0], (batch_size,), generator=g)
    Xb, Yb = Xtr[ix], Ytr[ix]

    # Forward pass
    emb = C[Xb] # grapping the randomly chosen rows of X
    # The .view re-interprets (32, 3, 2) as (32, 6)
    # The '-1' in .view instructs torch to infer the '32' from the shape of W
    emb_cat = emb.view(emb.shape[0], -1)
    h_pre_act = emb_cat @ W1 + b1 # hidden layer pre-activation
    h = torch.tanh(h_pre_act) # hidden layer
    logits = h @ W2 + b2 # output layer
    loss = F.cross_entropy(logits, Yb)

    # Backward pass
    for p in parameters:
        p.grad = None
    loss.backward()

    # Update parameters
    lr = 0.1 if i < 10_000 else 0.01 
    for p in parameters:
        p.data += -lr * p.grad

    # Track stats
    if i % 1000 == 0:
        print(f'{i:7d}/{max_steps:7d}: {loss.item():.4f}')
    loss_i.append(loss.log10().item())

# Sample from the model

sample_bool = False
if sample_bool == True:

    g = torch.Generator().manual_seed(2147483647 + 10)
    
    for _ in range(20):
        out = []
        context = [0] * block_size
        while True:
            emb = C[torch.tensor([context])] # dimensions = (N_examples=1, block_size, n_embed)
            h = torch.tanh(emb.view(1,-1) @ W1 + b1)
            logits = h @ W2 + b2
            probs = F.softmax(logits, dim=1)
            ix = torch.multinomial(probs, num_samples=1, generator=g).item()
            context = context[1:] + [ix]
            out.append(ix)
            if ix == 0: # if end character .
                break
            
        print(''.join(i_to_char[i] for i in out))

